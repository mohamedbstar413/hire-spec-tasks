FROM bstar999/docker:with-bash

# Install diagnostic utilities & docker compose
RUN apt-get update && apt-get install -y \
    python3 \
    curl \
    git \
    sudo \
    vim \
    nano \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create application directory
RUN mkdir -p /app

# Create Python application in /app/app.py
RUN cat << 'EOF' > /app/app.py
import time

print("Web service started with valid resource allocations!", flush=True)
while True:
    time.sleep(3600)
EOF

# Create Dockerfile in /app/Dockerfile
RUN cat << 'EOF' > /app/Dockerfile
FROM python:3.9-slim
WORKDIR /app
COPY app.py .
CMD ["python3", "app.py"]
EOF

# Create docker-compose.yml with FAULT (limits set less than reservations)
RUN cat << 'EOF' > /app/docker-compose.yml
version: '3.8'

services:
  web_service:
    build: .
    container_name: web_resource_container
    deploy:
      resources:
        reservations:
          cpus: '2.0'
          memory: '512M'
        limits:
          # FAULT: Limits set less than reservations (0.5 < 2.0 CPUs, 128M < 512M memory)
          cpus: '0.5'
          memory: '128M'
EOF

USER root
WORKDIR /app
