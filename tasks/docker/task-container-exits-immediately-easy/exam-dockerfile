FROM bstar999/docker:with-bash

# Install additional diagnostic utilities
RUN apt-get update && apt-get install -y \
    curl \
    git \
    sudo \
    vim \
    nano \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create application directory
RUN mkdir -p /app

# Create application code requiring DB_PORT environment variable
RUN cat << 'EOF' > /app/app.py
import os, sys, time

db_port = os.environ.get("DB_PORT")
if not db_port:
    print("CRITICAL ERROR: DB_PORT environment variable is missing!", file=sys.stderr)
    print("Application failed initialization. Exiting with status 1...", file=sys.stderr)
    sys.exit(1)

print(f"Server started successfully on port {db_port}...", flush=True)
while True:
    time.sleep(3600)
EOF

# Create initial faulty Dockerfile in /app
RUN cat << 'EOF' > /app/Dockerfile
FROM python:3.9-slim
WORKDIR /app
COPY app.py .
CMD ["python3", "app.py"]
EOF

USER root
WORKDIR /app
