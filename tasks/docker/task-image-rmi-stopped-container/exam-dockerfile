FROM bstar999/docker:with-bash

# Install diagnostic utilities
RUN apt-get update && apt-get install -y \
    curl \
    git \
    sudo \
    vim \
    nano \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create application directory
RUN mkdir -p /app

# Create script to populate stopped container and legacy image on startup
RUN cat << 'EOF' > /app/setup_fault.sh
#!/bin/bash
if ! docker images --format '{{.Repository}}:{{.Tag}}' | grep -q "^legacy-app:v1$"; then
    cat << 'DOCKERFILE' > /tmp/Dockerfile.legacy
FROM alpine:latest
RUN echo "Legacy application data blob" > /app_data.txt
DOCKERFILE
    docker build -t legacy-app:v1 -f /tmp/Dockerfile.legacy /tmp >/dev/null 2>&1 || true
    docker run --name stopped_legacy_app legacy-app:v1 echo "Exited app" >/dev/null 2>&1 || true
fi
EOF
RUN chmod +x /app/setup_fault.sh

# Ensure setup_fault.sh runs automatically when bash shell starts
RUN echo '(/app/setup_fault.sh >/dev/null 2>&1 &)' >> /root/.bashrc

USER root
WORKDIR /app
