FROM bstar999/docker:with-bash

# Install diagnostic utilities, qemu-user-static, and binfmt support for multi-arch builds
RUN apt-get update && apt-get install -y \
    curl \
    git \
    sudo \
    vim \
    nano \
    tar \
    jq \
    qemu-user-static \
    binfmt-support \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Enable BuildKit by default
ENV DOCKER_BUILDKIT=1

# Create application directory /app
RUN mkdir -p /app

# Create Python application in /app/app.py
RUN cat << 'EOF' > /app/app.py
import platform, sys

print(f"Application running on architecture: {platform.machine()}", flush=True)
EOF

# Create Dockerfile in /app/Dockerfile
RUN cat << 'EOF' > /app/Dockerfile
FROM python:3.9-slim
WORKDIR /app
COPY app.py .
CMD ["python3", "app.py"]
EOF

USER root
WORKDIR /app
