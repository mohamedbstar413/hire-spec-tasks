FROM bstar999/linux-lab-image:systemd

ENV DEBIAN_FRONTEND=noninteractive

# Install quota management tools and standard utilities
RUN apt-get update && apt-get install -y \
    quota \
    quotatool \
    e2fsprogs \
    sudo \
    shadow \
    coreutils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create candidate user with passwordless sudo
RUN useradd -m -s /bin/bash candidate && \
    echo "candidate ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/candidate && \
    chmod 0440 /etc/sudoers.d/candidate

# Create test user and group for quota assignment
RUN groupadd devgroup && \
    useradd -m -s /bin/bash -g devgroup devuser

# Create shared storage directory
RUN mkdir -p /mnt/shared-storage && \
    chown root:devgroup /mnt/shared-storage && \
    chmod 775 /mnt/shared-storage

USER root
WORKDIR /root

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
