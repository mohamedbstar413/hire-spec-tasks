FROM bstar999/linux-lab-image:systemd

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 \
    curl \
    netcat-openbsd \
    sudo \
    vim \
    nano \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create health check endpoint directory and file
RUN mkdir -p /opt/web2 && \
    echo "OK" > /opt/web2/health

# Create systemd service running Python HTTP server on port 8081
RUN cat << 'EOF' > /etc/systemd/system/web2.service
[Unit]
Description=Health endpoint
After=network.target

[Service]
WorkingDirectory=/opt/web2
ExecStart=/usr/bin/python3 -m http.server 8081
Restart=always

[Install]
WantedBy=multi-user.target
EOF

RUN systemctl enable web2.service

# Create hostcheck script
RUN mkdir -p /opt/hostcheck

RUN cat << 'EOF' > /opt/hostcheck/check.sh
#!/bin/bash
curl -s -o /dev/null -w "%{http_code}\n" --connect-timeout 3 http://internal-api.company.local:8081/health
EOF

RUN chmod +x /opt/hostcheck/check.sh

# Inject stale/wrong entry into /etc/hosts pointing to unreachable IP
RUN echo "203.0.113.50 internal-api.company.local" >> /etc/hosts

# Ensure candidate user exists with passwordless sudo access
RUN id candidate >/dev/null 2>&1 || useradd -m -s /bin/bash candidate && \
    echo "candidate ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/candidate && \
    chmod 0440 /etc/sudoers.d/candidate

USER root
WORKDIR /root

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
