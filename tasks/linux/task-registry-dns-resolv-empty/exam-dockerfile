FROM bstar999/linux-lab-image:systemd

ENV DEBIAN_FRONTEND=noninteractive

# Install curl, dnsutils, netcat, and diagnostic tools
RUN apt-get update && apt-get install -y \
    curl \
    dnsutils \
    netcat-openbsd \
    iputils-ping \
    sudo \
    vim \
    nano \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create helper script /opt/scripts/check_connectivity.sh
RUN mkdir -p /opt/scripts
RUN cat << 'EOF' > /opt/scripts/check_connectivity.sh
#!/bin/bash
echo "Testing connection to external web service..."
if curl -s --connect-timeout 5 https://google.com >/dev/null; then
    echo "SUCCESS: Connection established successfully!"
    exit 0
else
    echo "FATAL: Could not connect to host. Network request failed."
    exit 1
fi
EOF
RUN chmod +x /opt/scripts/check_connectivity.sh

# FAULT INJECTION: Empty /etc/resolv.conf
RUN > /etc/resolv.conf
