FROM bstar999/linux-lab-image:systemd

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    acl \
    sudo \
    python3 \
    curl \
    vim \
    nano \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create appuser and web directories
RUN id appuser >/dev/null 2>&1 || useradd -m -s /bin/bash appuser && \
    mkdir -p /var/www/uploads && \
    chown -R appuser:appuser /var/www/uploads && \
    chmod 775 /var/www/uploads

# Apply restrictive POSIX ACL mask so appuser cannot write despite 775 permissions
# setfacl -m m::r-x limits effective permissions of all user/group ACL entries to read/execute
RUN setfacl -m u:appuser:r-x /var/www/uploads && \
    setfacl -m m::r-x /var/www/uploads

# Ensure candidate user exists with passwordless sudo access
RUN id candidate >/dev/null 2>&1 || useradd -m -s /bin/bash candidate && \
    echo "candidate ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/candidate && \
    chmod 0440 /etc/sudoers.d/candidate

USER root
WORKDIR /root

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
