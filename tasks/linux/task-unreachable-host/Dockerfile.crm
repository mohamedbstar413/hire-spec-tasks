FROM bstar999/linux-lab-image:systemd

ENV DEBIAN_FRONTEND=noninteractive

# Install Nginx web server, iptables, and troubleshooting utilities
RUN apt-get update && apt-get install -y \
    nginx \
    iptables \
    iptables-persistent \
    iputils-ping \
    net-tools \
    iproute2 \
    curl \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Configure web application landing page
RUN mkdir -p /var/www/html && \
    echo "<h1>Welcome to CRM Internal Portal</h1>" > /var/www/html/index.html

# Enable Nginx systemd service on boot
RUN systemctl enable nginx

# Inject Faulty Environment:
# Configure iptables rules file to silently drop incoming TCP traffic on port 80
RUN mkdir -p /etc/iptables && \
    echo '*filter\n:INPUT ACCEPT [0:0]\n:FORWARD ACCEPT [0:0]\n:OUTPUT ACCEPT [0:0]\n-A INPUT -p tcp --dport 80 -j DROP\nCOMMIT' > /etc/iptables/rules.v4

# Enable netfilter-persistent so the drop rule loads on system start
RUN systemctl enable netfilter-persistent

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
