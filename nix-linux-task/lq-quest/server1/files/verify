HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 http://server2)
if [ "$HTTP_CODE" = "200" ]; then
    echo "SUCCESS: Nginx is running on server2 and responding with HTTP 200."
    exit 0
else
    echo "FAILED: Expected HTTP 200 from server2, got: ${HTTP_CODE:-000}"
    exit 1
fi
